#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <openssl/evp.h>
#include <openssl/aes.h>
#include <openssl/rand.h>

#define AES_KEYLEN 16 // 128 bits
#define CHACHA_KEYLEN 32
#define CHACHA_NONCELEN 12

// AES-128 ECB encryption
void aes_encrypt(const unsigned char *plaintext, unsigned char *ciphertext, int len, const unsigned char *key) {
    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
    int outlen;
    EVP_EncryptInit_ex(ctx, EVP_aes_128_ecb(), NULL, key, NULL);
    EVP_CIPHER_CTX_set_padding(ctx, 0);
    EVP_EncryptUpdate(ctx, ciphertext, &outlen, plaintext, len);
    EVP_CIPHER_CTX_free(ctx);
}

// AES-128 ECB decryption
void aes_decrypt(const unsigned char *ciphertext, unsigned char *plaintext, int len, const unsigned char *key) {
    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
    int outlen;
    EVP_DecryptInit_ex(ctx, EVP_aes_128_ecb(), NULL, key, NULL);
    EVP_CIPHER_CTX_set_padding(ctx, 0);
    EVP_DecryptUpdate(ctx, plaintext, &outlen, ciphertext, len);
    EVP_CIPHER_CTX_free(ctx);
}

// ChaCha20 stream encryption/decryption
void chacha_crypt(const unsigned char *input, unsigned char *output, int len, const unsigned char *key, const unsigned char *nonce) {
    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
    int outlen;
    EVP_EncryptInit_ex(ctx, EVP_chacha20(), NULL, key, nonce);
    EVP_EncryptUpdate(ctx, output, &outlen, input, len);
    EVP_CIPHER_CTX_free(ctx);
}

// Final encryption: AES + ChaCha20 + XOR
void encrypt(const unsigned char *plaintext, unsigned char *final_ciphertext, int len,
             const unsigned char *aes_key, const unsigned char *chacha_key, const unsigned char *nonce) {
    unsigned char *aes_ciphertext = malloc(len);
    unsigned char *chacha_output = malloc(len);

    aes_encrypt(plaintext, aes_ciphertext, len, aes_key);
    chacha_crypt(plaintext, chacha_output, len, chacha_key, nonce);

    for (int i = 0; i < len; i++) {
        final_ciphertext[i] = aes_ciphertext[i] ^ chacha_output[i];
    }

    free(aes_ciphertext);
    free(chacha_output);
}

// Final decryption: XOR -> AES decryption
void decrypt(const unsigned char *final_ciphertext, unsigned char *plaintext, int len,
             const unsigned char *aes_key, const unsigned char *chacha_key, const unsigned char *nonce) {
    unsigned char *chacha_output = malloc(len);
    unsigned char *aes_input = malloc(len);

    chacha_crypt(plaintext, chacha_output, len, chacha_key, nonce);  // ChaCha20 keystream
    for (int i = 0; i < len; i++) {
        aes_input[i] = final_ciphertext[i] ^ chacha_output[i];
    }

    aes_decrypt(aes_input, plaintext, len, aes_key);

    free(chacha_output);
    free(aes_input);
}



int main() {
    const unsigned char aes_key[AES_KEYLEN] = "0123456789ABCDEF";
    const unsigned char chacha_key[CHACHA_KEYLEN] = "0123456789ABCDEF0123456789ABCDEF";
    const unsigned char nonce[CHACHA_NONCELEN] = "123456789012";

    const char *text = "HelloWorldHelloW"; // 16 bytes (multiple of 16)
    int len = strlen(text);
    unsigned char ciphertext[256] = {0};
    unsigned char decrypted[256] = {0};

    encrypt((const unsigned char*)text, ciphertext, len, aes_key, chacha_key, nonce);
    decrypt(ciphertext, decrypted, len, aes_key, chacha_key, nonce);

    printf("Original:  %s\n", text);
    printf("Decrypted: %s\n", decrypted);

    return 0;
}
